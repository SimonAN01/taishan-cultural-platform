# Copy to .env and fill credentials locally; never commit the real .env.
# Shell-compatible KEY=value format. Quote values containing spaces or shell characters.
# Python does NOT load this file automatically: source it before starting Uvicorn.
# The provided systemd unit reads /opt/taishan/.env via EnvironmentFile.

# Text guide: coze (recommended deployed agent) or llm (direct model API).
# With no credentials the guide returns cited local material, not generated text.
AGENT_PROVIDER=coze
COZE_API_URL=https://7szbsmhhq8.coze.site/stream_run
COZE_API_TOKEN=
# Optional integer. The existing deployment was verified without project_id.
COZE_PROJECT_ID=

# Cloud image recognition uses these independently of Coze.
# AGENT_PROVIDER=llm also uses these for text answers.
# Base URL only: the application appends /chat/completions.
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_MODEL=deepseek-v4.1-flash
LLM_API_KEY=
VISION_BACKEND=cloud

# Optional paths. Defaults work for the repository layout and local development.
# IMMERSIVE_FRONTEND_DIR=/absolute/path/to/digital-media-projects/dist
# DATA_DIR=/absolute/path/to/digital-media-projects/taishan/runtime
# EMBEDDING_MODEL_DIR=/absolute/path/to/digital-media-projects/taishan/models/bge
# CLIP_MODEL_DIR=/absolute/path/to/digital-media-projects/taishan/models/clip

# On the existing server, keep its real credentials and set:
# IMMERSIVE_FRONTEND_DIR=/opt/taishan/immersive
# DATA_DIR=/opt/taishan/runtime
# TTS voice is defined in backend/speech.py, not an environment variable.
