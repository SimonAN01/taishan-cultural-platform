[Unit]
Description=Taishan local Qwen3 language model
After=network.target

[Service]
User=taishan
Group=taishan
WorkingDirectory=/opt/taishan
ExecStart=/opt/taishan/vendor/llama/llama-server -m /opt/taishan/models/Qwen3-0.6B-Q8_0.gguf --host 127.0.0.1 --port 18601 --ctx-size 4096 --threads 2 --parallel 1 --alias taishan-qwen --jinja --reasoning off
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=1200M
CPUQuota=150%

[Install]
WantedBy=multi-user.target
